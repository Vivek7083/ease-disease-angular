{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/actions/**",
              "components/brand/**",
              "components/chat/**",
              "components/content/**",
              "components/navigation/**",
              "components/story/**",
              "components/surfaces/**",
              "ui_kits/root-map/**",
              "ui_kits/scrollytelling/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Fraunces|DM Sans|DM Mono))/i]",
        "message": "Font not provided by the design system. Available: Fraunces, DM Sans, DM Mono."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatBubble'] > JSXAttribute > JSXIdentifier[name!=/^(?:unread|open|onClick|label|offsetRight|key|ref|className|style|children)$/]",
        "message": "<ChatBubble> doesn't accept that prop. Declared props: unread, open, onClick, label, offsetRight."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute > JSXIdentifier[name!=/^(?:from|text|key|ref|className|style|children)$/]",
        "message": "<ChatMessage> doesn't accept that prop. Declared props: from, text."
      },
      {
        "selector": "JSXOpeningElement[name.name='ChatMessage'] > JSXAttribute[name.name='from'] > Literal[value!=/^(?:guide|user)$/]",
        "message": "<ChatMessage> from must be one of 'guide' | 'user'."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaPill'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|variant|compact|meta|disabled|floating|href|onClick|key|ref|className|style|children)$/]",
        "message": "<CtaPill> doesn't accept that prop. Declared props: label, variant, compact, meta, disabled, floating, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='CtaPill'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|ghost)$/]",
        "message": "<CtaPill> variant must be one of 'primary' | 'ghost'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayBlock'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|count|headline|body|highlight|tone|size|align|children|key|ref|className|style|children)$/]",
        "message": "<DisplayBlock> doesn't accept that prop. Declared props: eyebrow, count, headline, body, highlight, tone, size, align, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayBlock'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<DisplayBlock> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayBlock'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:xl|l|m|s)$/]",
        "message": "<DisplayBlock> size must be one of 'xl' | 'l' | 'm' | 's'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DisplayBlock'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|center)$/]",
        "message": "<DisplayBlock> align must be one of 'left' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceTick'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|source|key|ref|className|style|children)$/]",
        "message": "<EvidenceTick> doesn't accept that prop. Declared props: children, tone, source."
      },
      {
        "selector": "JSXOpeningElement[name.name='EvidenceTick'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<EvidenceTick> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='EyebrowLabel'] > JSXAttribute > JSXIdentifier[name!=/^(?:children|tone|rule|count|key|ref|className|style|children)$/]",
        "message": "<EyebrowLabel> doesn't accept that prop. Declared props: children, tone, rule, count."
      },
      {
        "selector": "JSXOpeningElement[name.name='EyebrowLabel'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<EyebrowLabel> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='FooterClose'] > JSXAttribute > JSXIdentifier[name!=/^(?:eyebrow|headline|body|links|supportEmail|whatsapp|brandName|onBook|key|ref|className|style|children)$/]",
        "message": "<FooterClose> doesn't accept that prop. Declared props: eyebrow, headline, body, links, supportEmail, whatsapp, brandName, onBook."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:index|name|description|state|duration|price|note|bullets|onBook|active|key|ref|className|style|children)$/]",
        "message": "<LevelCard> doesn't accept that prop. Declared props: index, name, description, state, duration, price, note, bullets, onBook, active."
      },
      {
        "selector": "JSXOpeningElement[name.name='LevelCard'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:bookable|later)$/]",
        "message": "<LevelCard> state must be one of 'bookable' | 'later'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuDot'] > JSXAttribute > JSXIdentifier[name!=/^(?:open|tone|onClick|label|key|ref|className|style|children)$/]",
        "message": "<MenuDot> doesn't accept that prop. Declared props: open, tone, onClick, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuDot'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:dark|light)$/]",
        "message": "<MenuDot> tone must be one of 'dark' | 'light'."
      },
      {
        "selector": "JSXOpeningElement[name.name='MenuOverlayItem'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|href|note|key|ref|className|style|children)$/]",
        "message": "<MenuOverlayItem> doesn't accept that prop. Declared props: label, href, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='SymptomNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|note|tone|size|state|center|selected|onClick|key|ref|className|style|children)$/]",
        "message": "<SymptomNode> doesn't accept that prop. Declared props: label, note, tone, size, state, center, selected, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='SymptomNode'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<SymptomNode> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SymptomNode'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<SymptomNode> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='SymptomNode'] > JSXAttribute[name.name='state'] > Literal[value!=/^(?:default|active|muted)$/]",
        "message": "<SymptomNode> state must be one of 'default' | 'active' | 'muted'."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCard'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|credential|role|tone|photoRatio|key|ref|className|style|children)$/]",
        "message": "<TeamCard> doesn't accept that prop. Declared props: name, credential, role, tone, photoRatio."
      },
      {
        "selector": "JSXOpeningElement[name.name='TeamCard'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<TeamCard> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thread'] > JSXAttribute > JSXIdentifier[name!=/^(?:orientation|length|progress|tone|curve|label|key|ref|className|style|children)$/]",
        "message": "<Thread> doesn't accept that prop. Declared props: orientation, length, progress, tone, curve, label."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thread'] > JSXAttribute[name.name='orientation'] > Literal[value!=/^(?:vertical|horizontal)$/]",
        "message": "<Thread> orientation must be one of 'vertical' | 'horizontal'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Thread'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Thread> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute > JSXIdentifier[name!=/^(?:name|text|tone|size|tagline|href|onClick|key|ref|className|style|children)$/]",
        "message": "<Wordmark> doesn't accept that prop. Declared props: name, text, tone, size, tagline, href, onClick."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:light|dark)$/]",
        "message": "<Wordmark> tone must be one of 'light' | 'dark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Wordmark'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Wordmark> size must be one of 'sm' | 'md' | 'lg'."
      }
    ]
  },
  "overrides": [
    {
      "files": [
        "**/index.js"
      ],
      "rules": {
        "no-restricted-imports": "off"
      }
    }
